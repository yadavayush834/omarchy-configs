#!/usr/bin/env bash

# Pomodoro timer for the Omarchy 4 Quickshell bar.
#
# Install this file as:
#   ~/.config/omarchy/bar/scripts/pomodoro
#
# Then add this entry to bar.layout.center in
# ~/.config/omarchy/shell.json, ideally after omarchy.indicators:
#
# {
#   "exec": "~/.config/omarchy/bar/scripts/pomodoro status",
#   "fontSize": 12,
#   "horizontalMargin": 8.5,
#   "id": "pomodoro",
#   "interval": 1,
#   "onClick": "~/.config/omarchy/bar/scripts/pomodoro click",
#   "onMiddleClick": "~/.config/omarchy/bar/scripts/pomodoro stop",
#   "onRightClick": "~/.config/omarchy/bar/scripts/pomodoro reset",
#   "type": "command"
# }
#
# Controls:
#   Left click   Add a task or pause/resume the current task
#   Right click  Reset the current task to its original duration
#   Middle click Stop and clear the current task

set -u

default_seconds=1500
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/omarchy-pomodoro"
state_file="${state_dir}/state"
lock_file="${state_dir}/lock"

action="${1:-status}"

setup_timer() {
  local script_path entered_task entered_minutes
  script_path="$(readlink -f "$0")"

  entered_task="$(gum input \
    --header="What are you working on?" \
    --placeholder="e.g. Revise chapter 4" \
    --prompt="Task: ")" || return 0

  [[ -n "${entered_task//[[:space:]]/}" ]] || return 0

  while true; do
    entered_minutes="$(gum input \
      --header="How long do you want to focus?" \
      --value="25" \
      --prompt="Minutes: ")" || return 0

    if [[ "${entered_minutes}" =~ ^[1-9][0-9]*$ ]] && (( entered_minutes <= 1440 )); then
      break
    fi

    gum style --foreground 1 "Enter a whole number from 1 to 1440."
  done

  "${script_path}" start "${entered_task}" "${entered_minutes}"
  gum style --foreground 2 "Started: ${entered_task} (${entered_minutes} minutes)"
}

if [[ "${action}" == "setup" ]]; then
  setup_timer
  exit 0
fi

mkdir -p "${state_dir}"
exec 9>"${lock_file}"
flock 9

task=""
duration="${default_seconds}"
remaining="${default_seconds}"
end_at=0
running=0
completed=0
sessions=0

is_uint() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

load_state() {
  [[ -f "${state_file}" ]] || return 0

  while IFS='=' read -r key value; do
    case "${key}" in
      task)
        task="${value}"
        ;;
      duration)
        is_uint "${value}" && (( value > 0 )) && duration="${value}"
        ;;
      remaining)
        is_uint "${value}" && remaining="${value}"
        ;;
      end_at)
        is_uint "${value}" && end_at="${value}"
        ;;
      running)
        [[ "${value}" == "0" || "${value}" == "1" ]] && running="${value}"
        ;;
      completed)
        [[ "${value}" == "0" || "${value}" == "1" ]] && completed="${value}"
        ;;
      sessions)
        is_uint "${value}" && sessions="${value}"
        ;;
    esac
  done < "${state_file}"
}

save_state() {
  local temporary
  temporary="$(mktemp "${state_dir}/state.XXXXXX")"
  {
    printf 'task=%s\n' "${task}"
    printf 'duration=%s\n' "${duration}"
    printf 'remaining=%s\n' "${remaining}"
    printf 'end_at=%s\n' "${end_at}"
    printf 'running=%s\n' "${running}"
    printf 'completed=%s\n' "${completed}"
    printf 'sessions=%s\n' "${sessions}"
  } > "${temporary}"
  mv "${temporary}" "${state_file}"
}

refresh_expired_timer() {
  local now
  now="$(date +%s)"

  if (( running == 1 )); then
    remaining=$((end_at - now))
    if (( remaining <= 0 )); then
      remaining=0
      running=0
      end_at=0
      completed=1
      sessions=$((sessions + 1))
      save_state
      notify-send --app-name="Pomodoro" --icon="appointment-soon" \
        "Pomodoro complete" "Finished: ${task}" >/dev/null 2>&1 || true
    fi
  fi
}

format_time() {
  local minutes seconds
  minutes=$((remaining / 60))
  seconds=$((remaining % 60))
  printf '%02d:%02d' "${minutes}" "${seconds}"
}

print_status() {
  local icon short_task state_word class_name text tooltip
  icon="󰔟"
  short_task="${task}"
  if (( ${#short_task} > 18 )); then
    short_task="${short_task:0:17}…"
  fi

  if [[ -z "${task}" ]]; then
    state_word="idle"
    class_name="idle"
    text="${icon}"
    printf -v tooltip 'Pomodoro · No task\nLeft click: add a task and choose the timer'
  elif (( running == 1 )); then
    state_word="running"
    class_name="active"
    text="${icon} $(format_time) · ${short_task}"
    printf -v tooltip '%s · %s remaining · %s\nLeft: pause · Right: reset · Middle: stop' \
      "${task}" "$(format_time)" "${state_word}"
  elif (( completed == 1 )); then
    state_word="complete"
    class_name="active"
    text="${icon} 00:00 · ${short_task}"
    printf -v tooltip '%s · complete · %s task(s) finished\nLeft: new task · Right: reset · Middle: stop' \
      "${task}" "${sessions}"
  elif (( remaining < duration )); then
    state_word="paused"
    class_name="paused"
    text="${icon} $(format_time) · ${short_task}"
    printf -v tooltip '%s · %s remaining · %s\nLeft: resume · Right: reset · Middle: stop' \
      "${task}" "$(format_time)" "${state_word}"
  else
    state_word="ready"
    class_name="idle"
    text="${icon} $(format_time) · ${short_task}"
    printf -v tooltip '%s · %s · %s\nLeft: start · Right: reset · Middle: stop' \
      "${task}" "$(format_time)" "${state_word}"
  fi

  jq -cn \
    --arg text "${text}" \
    --arg tooltip "${tooltip}" \
    --arg class "${class_name}" \
    '{text: $text, tooltip: $tooltip, class: $class}'
}

toggle_timer() {
  local now
  now="$(date +%s)"

  [[ -n "${task}" && "${completed}" == "0" ]] || return 0

  if (( running == 1 )); then
    remaining=$((end_at - now))
    (( remaining < 0 )) && remaining=0
    running=0
    end_at=0
  else
    (( remaining <= 0 )) && remaining="${duration}"
    running=1
    end_at=$((now + remaining))
  fi
  save_state
}

reset_timer() {
  [[ -n "${task}" ]] || return 0

  remaining="${duration}"
  running=0
  end_at=0
  completed=0
  save_state
}

stop_timer() {
  task=""
  duration="${default_seconds}"
  remaining="${default_seconds}"
  running=0
  end_at=0
  completed=0
  save_state
}

start_timer() {
  local new_task="${1:-}" minutes="${2:-}"

  new_task="${new_task//$'\n'/ }"
  new_task="${new_task//$'\r'/ }"
  if [[ -z "${new_task//[[:space:]]/}" || ! "${minutes}" =~ ^[1-9][0-9]*$ ]] || (( minutes > 1440 )); then
    printf 'Usage: %s start "task" <minutes: 1-1440>\n' "${0##*/}" >&2
    return 2
  fi

  task="${new_task}"
  duration=$((minutes * 60))
  remaining="${duration}"
  running=1
  completed=0
  end_at=$(($(date +%s) + duration))
  save_state
}

open_setup() {
  local script_path
  script_path="$(readlink -f "$0")"
  flock -u 9
  exec 9>&-
  omarchy-launch-floating-terminal-with-presentation "${script_path} setup"
}

handle_click() {
  if [[ -z "${task}" ]] || (( completed == 1 )); then
    open_setup
  else
    toggle_timer
  fi
}

load_state
refresh_expired_timer

case "${action}" in
  status)
    print_status
    ;;
  click)
    handle_click
    ;;
  toggle)
    toggle_timer
    ;;
  start)
    start_timer "${2:-}" "${3:-}"
    ;;
  reset)
    reset_timer
    ;;
  stop)
    stop_timer
    ;;
  *)
    printf 'Usage: %s {status|click|setup|toggle|start|reset|stop}\n' "${0##*/}" >&2
    exit 2
    ;;
esac
